# Copy to .env.local for local development, or set these in your Vercel project.
# Never commit real values.

# Meta app (developers.facebook.com -> your app -> Instagram -> API setup with Instagram login)
META_APP_ID=your-app-id
# The Instagram app secret from that same page, NOT the App secret under Settings > Basic.
# Used for both webhook signature checks and the token exchange. Wrong value = every webhook 401s.
META_APP_SECRET=your-instagram-app-secret
META_API_VERSION=v25.0
# Any random string; paste the same value into the webhook "Verify token" field in the Meta dashboard.
WEBHOOK_VERIFY_TOKEN=your-random-verify-token
# 1 = no calls to Meta (local development and tests), 0 = real Instagram. Use 0 in production.
META_MOCK=1

# Supabase (Project settings -> API). Use the anon / publishable key and the service_role / secret key.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

# Comma-separated emails allowed into /admin (must also exist as Supabase Auth users).
ADMIN_EMAILS=admin@example.com

# Generate each with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=base64-of-32-random-bytes
OPTOUT_HASH_KEY=a-separate-base64-of-32-random-bytes
# At least 32 random characters, e.g. openssl rand -hex 24
JOB_SECRET=replace-with-at-least-32-random-characters

# Public HTTPS origin of this deployment: no path, no trailing port.
APP_URL=https://your-app.example.com

# Branding and account (see README)
# Shown as the page title in the app and /admin. Default: IG DM Automation
BRAND_NAME=Your Brand
# Required. The Instagram username this deployment runs for, without @.
# Used for follow prompts, the default profile link and post-lookup errors.
IG_USERNAME=yourhandle
# Optional pair, set both or neither. When both are set, any campaign message or button that links to
# REQUIRED_DISCLOSURE_URL must also contain REQUIRED_DISCLOSURE_TEXT in the message with links
# (or in the direct message). Leave both empty to turn the check off.
# REQUIRED_DISCLOSURE_URL=https://example.com/terms/
# REQUIRED_DISCLOSURE_TEXT=Fees and conditions apply.
# (in Vercel, enter the text without surrounding quotes)

# Optional setup inputs. Set META_TOKEN_INPUT as Sensitive in Vercel, deploy, connect, then delete it.
# META_TOKEN_INPUT=long-lived-instagram-token
# META_TOKEN_EXPIRES_IN=5184000
# CAMPAIGN_MEDIA_ID=instagram-media-id
# CAMPAIGN_MEDIA_PERMALINK=https://www.instagram.com/p/example/
DEBUG_RAW_EVENTS=0
